# .env.production.eng.example
# Copy to /root/UnicornsEduEng/.env on the VPS (instance `eng` in deploy/instances.json).
# NEVER commit the actual .env file.
#
# GitHub Actions builds web with NEXT_PUBLIC_BACKEND_URL=/api (shared IT + ENG image).

# ── Hồ sơ môn (BẮT BUỘC) ───────────────────────────────────────────────────────
# it | jp | eng. Thiếu hoặc sai thì API không khởi động.
# Xem docs/adr/2026-10-07-instance-subject-profile.md
LMS_PROFILE=eng

# ── Database + Storage (Supabase tối giản self-host, deploy/data-stack) ─────
# Postgres `db` và storage-api `storage` nằm trên network DATA_NETWORK của instance.
# Mật khẩu / service key lấy từ /root/uniedu-data/.env trên VPS (ENG_*).
DATA_NETWORK=uniedu-data-eng
DATABASE_URL="postgresql://uniedu_eng:PASSWORD@db:5432/uniedu_eng"
DIRECT_URL="postgresql://uniedu_eng:PASSWORD@db:5432/uniedu_eng"
SUPABASE_URL="https://eng.uniedu.vn"
SUPABASE_INTERNAL_URL="http://nginx"
SUPABASE_SERVICE_ROLE_KEY=""

# ── App URLs ─────────────────────────────────────────────────────────────────
PORT=4000
BACKEND_URL="https://eng.unicornsedu.com/api"
FRONTEND_URL="https://eng.unicornsedu.com"

# ── Reverse proxy ────────────────────────────────────────────────────────────
TRUST_PROXY=1

# ── JWT Secrets (generate with: openssl rand -base64 64) ─────────────────────
# MUST be unique per instance — do not reuse IT instance secrets.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EMAIL_VERIFY_SECRET=""
JWT_FORGOT_PASSWORD_SECRET=""

# ── Email / SMTP ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@unicornsedu.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
MAIL_FROM="no-reply@unicornsedu.com"

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://eng.unicornsedu.com/api/auth/google/callback"

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_BLOCK_DURATION_MS=60000

# ── Caching ──────────────────────────────────────────────────────────────────
DASHBOARD_CACHE_DEFAULT_TTL_SECONDS=60
AUTH_IDENTITY_CACHE_TTL_MS=5000
AUTH_IDENTITY_CACHE_MAX_ENTRIES=2000

# ── SePay student wallet top-up ──────────────────────────────────────────────
SEPAY_TOPUP_MODE="bank_transfer"
SEPAY_API_ACCESS_TOKEN=""
SEPAY_BANK_ACCOUNT_XID=""
SEPAY_TRANSFER_BANK_BIN="970422"
SEPAY_TRANSFER_ACCOUNT_NUMBER=""
SEPAY_TRANSFER_ACCOUNT_NAME=""
SEPAY_TRANSFER_BANK_NAME="MBBank"
SEPAY_TRANSFER_QR_TEMPLATE="compact2"
SEPAY_VIETQR_IMAGE_BASE_URL="https://img.vietqr.io/image"
SEPAY_WEBHOOK_SECRET=""
SEPAY_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
SEPAY_WEBHOOK_ALLOW_LEGACY_SECRET_KEY=0

# ── Instance compose overrides (optional — CD sets these automatically) ──────
# COMPOSE_PROJECT_NAME=unicorns-eng
# NGINX_PUBLISH=127.0.0.1:8080:80
