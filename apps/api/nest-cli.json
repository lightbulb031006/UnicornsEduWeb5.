{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "mail/assets/**/*",
        "watchAssets": true
      },
      {
        "include": "storage/assets/**/*",
        "watchAssets": true
      }
    ]
  },
  "watchAssets": true
}
